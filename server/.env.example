# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# Note: Default port is 5432. If your postgres runs on another port (e.g. 5433), check with:
#   sudo -u postgres psql -c 'SHOW port;'
DATABASE_URL=postgresql://username:password@localhost:5432/digiplay_db

# Security & Authentication
# Generate a secure 32-byte secret (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SECRET_KEY=your_jwt_secret_key_here

# Mobile App Shared API Key
APP_API_KEY=your_mobile_app_api_key_here

# Runtime Environment (development | production)
#ENVIRONMENT=development
#PORT=8000
